
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* Authentication */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    function owns(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    /* Payment Settings Validation */

    function paymentSettingsMatch() {
      return exists(
        /databases/$(database)/documents/settings/payment
      )
      && request.resource.data.amount ==
        get(
          /databases/$(database)/documents/settings/payment
        ).data.amount
      && request.resource.data.durationDays ==
        get(
          /databases/$(database)/documents/settings/payment
        ).data.durationDays;
    }

    /* Subscription Check */

    function activeMember() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.subscription.active == true
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.subscription.expiresAt == null
          ||
          request.time <
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.subscription.expiresAt
        );
    }

    /* Users */

    match /users/{uid} {

      allow read: if owns(uid) || isAdmin();

      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'createdAt',
          'subscription'
        ])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.subscription.active == false
        && request.resource.data.subscription.expiresAt == null
        && request.resource.data.subscription.keys().hasOnly([
          'active',
          'expiresAt'
        ]);

      /* User Profile Update OR Admin Subscription Approval */

      allow update: if (

        owns(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.phone is string

      ) || (

        isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['subscription'])
        && request.resource.data.subscription.active == true
        && request.resource.data.subscription.approvedPaymentId is string
        && request.resource.data.subscription.keys().hasOnly([
          'active',
          'expiresAt',
          'approvedPaymentId'
        ])
        && (
          request.resource.data.subscription.expiresAt == null
          || request.resource.data.subscription.expiresAt is timestamp
        )
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.subscription.approvedPaymentId)
        ).data.uid == uid
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.subscription.approvedPaymentId)
        ).data.status == 'approved'
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.subscription.approvedPaymentId)
        ).data.approvedBy == request.auth.uid

      );

      allow delete: if false;
    }

    /* Payments */

    match /payments/{paymentId} {

      allow read: if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      /* First Payment Submission */

      allow create: if owns(paymentId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'trxid',
          'amount',
          'durationDays',
          'status',
          'correctionCount',
          'rejectCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.trxid is string
        && request.resource.data.trxid.size() >= 5
        && request.resource.data.amount is number
        && request.resource.data.durationDays is int
        && request.resource.data.durationDays >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.correctionCount == 0
        && request.resource.data.rejectCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && paymentSettingsMatch();

      /* Payment Updates */

      allow update: if (

        /* User Corrects Pending Transaction ID */

        (
          owns(paymentId)
          && resource.data.status == 'pending'
          && resource.data.correctionCount < 3
          && request.resource.data.status == 'pending'
          && request.resource.data.trxid is string
          && request.resource.data.trxid.size() >= 5
          && request.resource.data.trxid != resource.data.trxid
          && request.resource.data.correctionCount ==
            resource.data.correctionCount + 1
          && request.resource.data.rejectCount ==
            resource.data.rejectCount
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'trxid',
              'amount',
              'durationDays',
              'correctionCount',
              'updatedAt'
            ])
          && request.resource.data.updatedAt == request.time
          && paymentSettingsMatch()
        )

        ||

        /* User Resubmits After Admin Rejection */

        (
          owns(paymentId)
          && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending'
          && request.resource.data.trxid is string
          && request.resource.data.trxid.size() >= 5
          && request.resource.data.trxid != resource.data.trxid
          && request.resource.data.correctionCount == 0
          && request.resource.data.rejectCount ==
            resource.data.rejectCount
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'status',
              'trxid',
              'amount',
              'durationDays',
              'correctionCount',
              'reviewNote',
              'updatedAt'
            ])
          && request.resource.data.updatedAt == request.time
          && paymentSettingsMatch()
        )

        ||

        /* Admin Approves */

        (
          isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'approved'
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'status',
              'approvedAt',
              'approvedBy'
            ])
          && request.resource.data.approvedAt == request.time
          && request.resource.data.approvedBy == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/users/$(resource.data.uid)
          ).data.subscription.active == true
          && getAfter(
            /databases/$(database)/documents/users/$(resource.data.uid)
          ).data.subscription.approvedPaymentId == paymentId
        )

        ||

        /* Admin Rejects */

        (
          isAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'rejected'
          && request.resource.data.rejectCount ==
            resource.data.rejectCount + 1
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'status',
              'rejectCount',
              'reviewNote',
              'reviewedAt',
              'reviewedBy'
            ])
          && request.resource.data.reviewNote is string
          && request.resource.data.reviewNote.size() <= 300
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.reviewedBy == request.auth.uid
        )
      );

      allow delete: if false;

      /* Transaction ID History */

      match /history/{historyId} {

        allow read: if owns(paymentId) || isAdmin();

        allow create: if owns(paymentId)
          && request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'trxid',
            'action',
            'correctionCount',
            'createdAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.trxid is string
          && request.resource.data.trxid.size() >= 5
          && request.resource.data.action in [
            'submitted',
            'corrected',
            'resubmitted'
          ]
          && request.resource.data.correctionCount is int
          && request.resource.data.createdAt == request.time
          && getAfter(
            /databases/$(database)/documents/payments/$(paymentId)
          ).data.trxid == request.resource.data.trxid
          && getAfter(
            /databases/$(database)/documents/payments/$(paymentId)
          ).data.status == 'pending'
          && getAfter(
            /databases/$(database)/documents/payments/$(paymentId)
          ).data.correctionCount ==
            request.resource.data.correctionCount;

        allow update, delete: if false;
      }
    }

    /* Payment Settings */

    match /settings/{settingId} {

      allow read: if signedIn();

      allow create, update: if isAdmin()
        && settingId == 'payment'
        && request.resource.data.keys().hasOnly([
          'number',
          'amount',
          'durationDays',
          'updatedAt'
        ])
        && request.resource.data.number is string
        && request.resource.data.number.size() >= 5
        && request.resource.data.amount is number
        && request.resource.data.amount >= 1
        && request.resource.data.durationDays is int
        && request.resource.data.durationDays >= 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    /* Folders */

    match /folders/{folderId} {
      allow read: if isAdmin() || activeMember();
      allow create, update, delete: if isAdmin();
    }

    /* Files */

    match /files/{fileId} {
      allow read: if isAdmin() || activeMember();
      allow create, update, delete: if isAdmin();
    }

    /* Support Messages */

    match /support/{messageId} {

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'text',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 3000
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
